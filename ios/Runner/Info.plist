<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Leisure Ryde</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>leisureryde</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Location — passengers use WhenInUse; drivers need Always for background tracking -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>LeisureRyde needs your location to show nearby drivers and calculate your route.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>LeisureRyde needs your location in the background so passengers can track your journey in real time.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>LeisureRyde needs your location in the background so passengers can track your journey in real time.</string>

	<!-- Background location updates for driver GPS tracking -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- Network -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Camera & Photo Library for driver document / profile image uploads -->
	<key>NSCameraUsageDescription</key>
	<string>LeisureRyde needs your camera to upload profile photos and driver documents.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>LeisureRyde needs your photo library to upload profile photos and driver documents.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>LeisureRyde needs permission to save images to your photo library.</string>

	<!-- Microphone — required by some Firebase / WebView components -->
	<key>NSMicrophoneUsageDescription</key>
	<string>LeisureRyde may use the microphone for in-app communication features.</string>

</dict>
</plist>
